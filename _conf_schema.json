{
  "submit_requires_admin": {
    "description": "是否仅管理员可提交战报",
    "type": "bool",
    "default": false,
    "hint": "仅战报群可提交；开启后仅超管、战队管理员、AstrBot 管理员或本群群主/管理可提交；私聊始终禁止"
  },
  "ranking_limit": {
    "description": "排行榜展示条数",
    "type": "int",
    "default": 10
  },
  "ranking_image": {
    "description": "排行图片",
    "type": "bool",
    "default": true,
    "hint": "关闭后显示文字表格"
  },
  "ranking_image_max_rows": {
    "description": "全战队排行图片行数",
    "type": "int",
    "default": 30,
    "hint": "仅影响 /排行 全部；本队排行显示全部队员"
  },
  "ranking_ai_comment": {
    "description": "排行后自动点评",
    "type": "bool",
    "default": true,
    "hint": "使用 AstrBot 当前会话的聊天模型和人格追加简短点评；需先在 AstrBot 配置聊天模型"
  },
  "min_games": {
    "description": "进入个人排行所需最少对局数",
    "type": "int",
    "default": 1
  },
  "min_duels": {
    "description": "战报最少对局数",
    "type": "int",
    "default": 3,
    "hint": "对局不足时不能提交；2 人赛制可调小"
  },
  "trend_chart_width": {
    "description": "趋势图宽度（px）",
    "type": "int",
    "default": 960
  },
  "trend_chart_height": {
    "description": "趋势图高度（px）",
    "type": "int",
    "default": 480
  },
  "default_rule": {
    "description": "排表默认规则",
    "type": "string",
    "default": "2/3【KOF】",
    "hint": "排表时未追加规则则使用此值"
  },
  "super_admin": {
    "description": "超级管理员 QQ",
    "type": "string",
    "default": "",
    "hint": "好友申请和入群邀请会私聊发给此 QQ；留空不开启超管功能"
  },
  "pairing_seed": {
    "description": "排表随机种子",
    "type": "string",
    "default": "",
    "hint": "留空随机，填写后固定配对"
  },
  "mysql_host": {
    "description": "MySQL 主机地址",
    "type": "string",
    "default": "127.0.0.1"
  },
  "mysql_port": {
    "description": "MySQL 端口",
    "type": "int",
    "default": 3306
  },
  "mysql_user": {
    "description": "MySQL 用户名",
    "type": "string",
    "default": "root"
  },
  "mysql_password": {
    "description": "MySQL 密码",
    "type": "string",
    "default": "",
    "hint": "安装后请在插件配置中填写数据库密码"
  },
  "mysql_db": {
    "description": "MySQL 数据库名",
    "type": "string",
    "default": "astrbot_battle_report"
  }
}
