{
  "platform_command_profiles": {
    "description": "平台指令配置",
    "type": "template_list",
    "default": [],
    "hint": "按机器人连接 ID 分配本插件指令。同一连接匹配多条时，最上面的配置生效；未配置的连接保持原默认范围。",
    "templates": {
      "platform": {
        "name": "平台指令配置",
        "display_item": "name",
        "items": {
          "name": {
            "description": "配置名称",
            "type": "string",
            "default": "新的平台配置"
          },
          "platform_ids": {
            "description": "机器人连接 ID",
            "type": "list",
            "default": [],
            "hint": "填写 /sid 回执中的 Bot ID，可填写多个连接。"
          },
          "mode": {
            "description": "开放方式",
            "type": "string",
            "default": "仅开放勾选指令",
            "options": [
              "仅开放勾选指令",
              "全部开放",
              "全部屏蔽"
            ]
          },
          "allowed_commands": {
            "description": "允许的指令",
            "type": "list",
            "default": [],
            "options": [
